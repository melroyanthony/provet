# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Shared LLM Configuration (Optional - these have defaults)
TEMPERATURE=0.7
MAX_TOKENS=800

# PHI Redaction Guardrails (true/false, default: true)
# Redacts microchip numbers, dates of birth, phone numbers, and emails
# before sending prompts to the LLM provider.
ENABLE_PHI_REDACTION=true

# Optional custom system instructions to add to the default
CUSTOM_SYSTEM_INSTRUCTION=It is extremely important that you follow the exact format provided in the prompt template. Do not deviate from the section structure or add extra sections.
